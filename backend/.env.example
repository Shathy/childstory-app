# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Free text-generation provider (MVP) - example: Groq / Google Gemini free tier / local Ollama
TEXT_AI_PROVIDER=groq
TEXT_AI_API_KEY=
TEXT_AI_MODEL=llama-3.1-70b-versatile

# Image generation - disabled for now, infra-ready only
IMAGE_AI_ENABLED=false
IMAGE_AI_PROVIDER=
IMAGE_AI_API_KEY=

# Chromium (PDF export via puppeteer-core)
# Local dev: point this to your installed Chrome/Chromium binary, e.g.
#   macOS:  /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:  /usr/bin/chromium
# On Render/Koyeb: the provided Dockerfile installs system Chromium and
# sets this automatically to /usr/bin/chromium — leave unset in dashboard env vars.
CHROMIUM_EXECUTABLE_PATH=

PORT=4000
